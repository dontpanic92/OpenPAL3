// Native 800x600 layout from the shipped executable's dialog constructor
// (0x450f90) and portrait/text placement routine (0x451360).

import radiance;
import scripting_services;
import shared.openpal3;
// Declarative widget lib. Aliased to `gui` so it doesn't collide with
// the `ui: IUiHost` render parameter.
import radiance_scripting.ui as gui;

pub struct[openpal3.IPal3DialogRenderer] Pal3DialogRendererImpl(
    pub sprites: &scripting_services.ISpriteService,
    // 9-slice chrome, by role (held for lifetime). null when missing.
    pub tl: ?&scripting_services.ISprite,
    pub bl: ?&scripting_services.ISprite,
    pub br: ?&scripting_services.ISprite,
    pub tr: ?&scripting_services.ISprite,
    pub left: ?&scripting_services.ISprite,
    pub bottom: ?&scripting_services.ISprite,
    pub right: ?&scripting_services.ISprite,
    pub top: ?&scripting_services.ISprite,
    pub center: ?&scripting_services.ISprite,
    pub deco: ?&scripting_services.ISprite,
    // Blinking page-advance indicator frames.
    pub page0: ?&scripting_services.ISprite,
    pub page1: ?&scripting_services.ISprite,
    // Avatar portrait (loaded on `set_avatar`) + side (0=left, 1=right).
    pub avatar: ?&scripting_services.ISprite,
    pub avatar_side: int,
    // Curtain/fade level in [-1, 1] and the indicator blink accumulator.
    pub curtain: float,
    pub indicator_t: float,
    pages: &DialogPages,
) {
    pub fn set_avatar(self: &Self, role: string, face: string, side: int) -> int {
        let path = "/basedata/basedata/ROLE/" + role + "/" + face + ".tga";
        self.avatar = self.sprites.load_sprite(path);
        self.avatar_side = side;
        0
    }

    pub fn clear_avatar(self: &Self) -> int {
        self.avatar = null;
        self.pages.page = 0;
        self.pages.has_more = false;
        0
    }

    pub fn advance_page(self: &Self) -> bool {
        if !self.pages.has_more { return false; }
        self.pages.page = self.pages.page + 1;
        self.pages.has_more = false;
        return true;
    }

    pub fn set_curtain(self: &Self, value: float) -> int {
        self.curtain = value;
        0
    }

    pub fn render_dialog(
        self: &Self,
        ui: &radiance.IUiHost,
        text: string,
        dt: float,
    ) -> int {
        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        let dialog_x = 0.0;
        let dialog_y = 458.0;
        let dialog_bottom = 594.0;
        let dialog_right = 800.0;
        let has_avatar = self.avatar != null;
        let avatar_at_right = self.avatar_side == 1;

        // Inner corners of the 9-slice (from each corner sprite's size).
        let tl_ix = dialog_x + sprite_w(self.tl);
        let tl_iy = dialog_y + sprite_h(self.tl);
        let bl_ix = dialog_x + sprite_w(self.bl);
        let bl_iy = dialog_bottom - sprite_h(self.bl);
        let br_ix = dialog_right - sprite_w(self.br);
        let br_iy = dialog_bottom - sprite_h(self.br);
        let tr_ix = dialog_right - sprite_w(self.tr);
        let tr_iy = dialog_y + sprite_h(self.tr);

        self.indicator_t = self.indicator_t + dt;
        if self.indicator_t > 1.0 { self.indicator_t = 0.0; }
        let ind = if self.indicator_t > 0.5 { self.page0 } else { self.page1 };
        // Original 0x4517a0 places the indicator opposite the portrait.
        let ci_x = if has_avatar && avatar_at_right { 18.0 } else { 760.0 };
        let text_x = if !has_avatar { 36.0 } else { if avatar_at_right { 54.0 } else { 276.0 } };
        let text_width = if has_avatar { 480.0 } else { 720.0 };

        // Declare the whole dialog box as a widget tree: the 9-slice
        // chrome, the bottom decoration, the optional avatar, the blink
        // indicator, then the wrapped text grid.
        let items: array<box<gui.Element>> = [
            sprite_rect(self.tl, dialog_x, dialog_y, tl_ix, tl_iy),
            sprite_rect(self.bl, dialog_x, bl_iy, bl_ix, dialog_bottom),
            sprite_rect(self.br, br_ix, br_iy, dialog_right, dialog_bottom),
            sprite_rect(self.tr, tr_ix, dialog_y, dialog_right, tr_iy),
            sprite_rect(self.left, dialog_x, tl_iy, dialog_x + sprite_w(self.left), bl_iy),
            sprite_rect(self.bottom, bl_ix, dialog_bottom - sprite_h(self.bottom), br_ix, dialog_bottom),
            sprite_rect(self.right, dialog_right - sprite_w(self.right), tr_iy, dialog_right, br_iy),
            sprite_rect(self.top, tl_ix, dialog_y, tr_ix, dialog_y + sprite_h(self.top)),
            sprite_rect(self.center, tl_ix, tl_iy, br_ix, br_iy),
            sprite_rect(self.deco, 333.0, 580.0, 467.0, 600.0),
            self.avatar_widget(has_avatar, avatar_at_right),
            sprite_rect(ind, ci_x, 552.0, ci_x + 32.0, 584.0),
            gui.NativeRect(800.0,
                text_x, 474.0, text_width, 120.0,
                DialogText(text, self.pages)),
        ];
        let root = gui.NativeCanvas(gui.Size(800.0, 600.0), items, true);
        gui.paint_root(root, ui, gui.make_ctx());
        0
    }

    pub fn avatar_widget(
        self: &Self,
        has_avatar: bool, avatar_at_right: bool,
    ) -> box<gui.Element> {
        if !has_avatar {
            let empty: array<box<gui.Element>> = [];
            return gui.Stack(empty);
        }
        let av = self.avatar!;
        let av_w = av.width() as float;
        let av_h = av.height() as float;
        if av_w <= 0.0 || av_h <= 0.0 {
            let empty: array<box<gui.Element>> = [];
            return gui.Stack(empty);
        }
        let x = if avatar_at_right { 544.0 } else { 0.0 };
        return gui.NativeRect(800.0, x, 88.0, 256.0, 512.0,
            Portrait(av, !avatar_at_right));
    }

    pub fn render_curtain(self: &Self, ui: &radiance.IUiHost) -> int {
        let c = self.curtain;
        if c == 0.0 { return 0; }

        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        // Magnitude is the fade opacity; sign selects the colour
        // (>= 0 fades to black, < 0 to white).
        let opacity = if c < 0.0 { 0.0 - c } else { c };
        let shade = if c < 0.0 { 1.0 } else { 0.0 };
        let root: box<gui.Element> = Curtain(shade, opacity);
        gui.paint_root(root, ui, gui.make_ctx());
        0
    }
}

fn sprite_rect(
    s: ?&scripting_services.ISprite,
    x0: float, y0: float, x1: float, y1: float,
) -> box<gui.Element> {
    return gui.NativeRect(800.0, x0, y0, x1 - x0, y1 - y0, gui.Sprite(s));
}

struct[gui.Element] Portrait(sprite: &scripting_services.ISprite, mirrored: bool) {
    fn measure(self: ref<Self>, avail: gui.Size, ui: &radiance.IUiHost) -> gui.Size { return avail; }
    fn paint(self: ref<Self>, rect: gui.Rect, ui: &radiance.IUiHost, ctx: box<gui.UiCtx>) {
        let sp = self.sprite;
        let u0 = if self.mirrored { sp.u1() } else { sp.u0() };
        let u1 = if self.mirrored { sp.u0() } else { sp.u1() };
        ui.image_rect(sp.com_id(), rect.x, rect.y, rect.right(), rect.bottom(),
            u0, sp.v0(), u1, sp.v1());
    }
}

// Native pixel width / height of a (possibly null) sprite, as a float.
fn sprite_w(s: ?&scripting_services.ISprite) -> float {
    if s == null { return 0.0; }
    return s!.width() as float;
}
fn sprite_h(s: ?&scripting_services.ISprite) -> float {
    if s == null { return 0.0; }
    return s!.height() as float;
}

// ---------------------------------------------------------------------------
// Screen-local widget leaves (declarative `gui.Element` impls).
// ---------------------------------------------------------------------------

// Original text renderer 0x4533f0: 20px CJK / 10px ASCII advance,
// 2px line gap; \b selects 24px, \s restores 20px, both on a new line.
struct DialogPages(pub page: int, pub has_more: bool) {}

pub struct[gui.Element] DialogText(content: string, pages: &DialogPages) {
    fn measure(self: ref<Self>, avail: gui.Size, ui: &radiance.IUiHost) -> gui.Size {
        return avail;
    }
    fn paint(self: ref<Self>, rect: gui.Rect,
             ui: &radiance.IUiHost, ctx: box<gui.UiCtx>) {
        let scale = rect.h / 120.0;
        let mut font_size = 20.0 * scale;
        let line_gap = 2.0 * scale;
        let wrap_limit = rect.w;
        let origin_x = rect.x;
        let top_y = rect.y;

        let text = self.content;
        let mut text_x = 0.0;
        let mut text_y = 0.0;
        let mut page = 0;
        self.pages.has_more = false;
        // Current text colour, default white. `\i` -> yellow, `\r` -> white.
        let mut cr = 1.0;
        let mut cg = 1.0;
        let mut cb = 1.0;

        let n = text.len_chars();
        let mut i = 0;
        while i < n {
            let oc = text.char_at(i);
            i = i + 1;
            if oc == null { continue; }
            let c = oc!;

            if c == "\n" {
                text_y = text_y + font_size + line_gap;
                text_x = 0.0;
                continue;
            }
            if c == "\\" && i < n {
                let next = text.char_at(i);
                if next != null && (next! == "i" || next! == "r") {
                    cb = if next! == "i" { 0.0 } else { 1.0 };
                    i = i + 1;
                    continue;
                }
                if next != null && (next! == "b" || next! == "s" || next! == "n") {
                    if next! == "b" { font_size = 24.0 * scale; }
                    text_y = text_y + font_size + line_gap;
                    text_x = 0.0;
                    if next! == "s" { font_size = 20.0 * scale; }
                    i = i + 1;
                    continue;
                }
            }
            let char_advance = if c.len_bytes() == 1 { font_size * 0.5 } else { font_size };
            if text_x > 0.0 && text_x + char_advance > wrap_limit + 0.01 {
                text_y = text_y + font_size + line_gap;
                text_x = 0.0;
            }
            if text_y + font_size > rect.h + 0.01 {
                page = page + 1;
                text_y = 0.0;
                text_x = 0.0;
            }
            if page > self.pages.page {
                self.pages.has_more = true;
                break;
            }
            if page == self.pages.page {
                ui.text_at_size(origin_x + text_x, top_y + text_y, font_size, cr, cg, cb, 1.0, c);
            }
            text_x = text_x + char_advance;
        }
    }
}

// Fullscreen fade curtain: a flat `(shade,shade,shade,opacity)` rect over
// the whole viewport. Replaces the legacy `render_curtain` `fill_rect`.
pub struct[gui.Element] Curtain(shade: float, opacity: float) {
    fn measure(self: ref<Self>, avail: gui.Size, ui: &radiance.IUiHost) -> gui.Size {
        return avail;
    }
    fn paint(self: ref<Self>, rect: gui.Rect,
             ui: &radiance.IUiHost, ctx: box<gui.UiCtx>) {
        ui.fill_rect(rect.x, rect.y, rect.right(), rect.bottom(),
                     self.shade, self.shade, self.shade, self.opacity);
    }
}

pub fn make_pal3_dialog_renderer(
    sprites: &scripting_services.ISpriteService,
) -> &openpal3.IPal3DialogRenderer {
    // Load the fixed chrome / indicator sprites once; each handle is
    // held by the renderer so its texture stays uploaded.
    let tl = sprites.load_sprite("/basedata/basedata/ui/flex/dlg0.tga");
    let bl = sprites.load_sprite("/basedata/basedata/ui/flex/dlg1.tga");
    let br = sprites.load_sprite("/basedata/basedata/ui/flex/dlg2.tga");
    let tr = sprites.load_sprite("/basedata/basedata/ui/flex/dlg3.tga");
    let left = sprites.load_sprite("/basedata/basedata/ui/flex/dlg4.tga");
    let bottom = sprites.load_sprite("/basedata/basedata/ui/flex/dlg5.tga");
    let right = sprites.load_sprite("/basedata/basedata/ui/flex/dlg6.tga");
    let top = sprites.load_sprite("/basedata/basedata/ui/flex/dlg7.tga");
    let center = sprites.load_sprite("/basedata/basedata/ui/flex/dlg8.tga");
    let deco = sprites.load_sprite("/basedata/basedata/ui/scene/timeclose.tga");
    let page0 = sprites.load_sprite("/basedata/basedata/ui/scene/page0.tga");
    let page1 = sprites.load_sprite("/basedata/basedata/ui/scene/page1.tga");

    return &Pal3DialogRendererImpl(
        sprites,
        tl, bl, br, tr, left, bottom, right, top, center, deco,
        page0, page1,
        null, 0,
        0.0, 0.0,
        &DialogPages(0, false),
    );
}
