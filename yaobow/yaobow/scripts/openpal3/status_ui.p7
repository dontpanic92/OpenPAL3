// PAL3 HUD and menu. Preload all portraits before drawing: texture uploads
// cannot borrow the shared texture cache during an imgui frame.
// Gameplay data is read-only; the p7 renderer owns navigation and press state.

import radiance;
import scripting_services;
import shared.openpal3;
import radiance_scripting.ui as gui;
// Full-screen character-status (状态) overlay, popped on avatar click.
import yaobow.openpal3.state_menu as state_menu;
import yaobow.openpal3.loading;

// Panel size as a fraction of framebuffer height. bk.tga is 128x128; the
// whole HUD is scaled uniformly so its on-screen height = lh * this.
let ST_PANEL_HEIGHT_FACTOR: float = 0.22;
// bk.tga has fully-transparent padding (57px right, 38px top). To snap the
// visible dial flush to the screen's right edge we shift right by that pad;
// to control the top gap we cancel the top pad and add a small native gap.
let ST_BK_RIGHT_PAD: float = 57.0;
let ST_BK_TOP_PAD: float   = 38.0;
let ST_TOP_GAP_PX: float   = 6.0;

// --- Native-pixel layout (relative to bk's top-left corner, 128px canvas) ---
// Each element is positioned + sized in bk's native pixels; the whole panel
// is scaled by (panel / BK_SIZE) to actual screen pixels.
let ST_BK_SIZE: float    = 128.0;
let ST_AVATAR_X: float   = 16.0;
let ST_AVATAR_Y: float   = 42.0;
let ST_AVATAR_W: float   = 64.0;
let ST_AVATAR_H: float   = 64.0;
let ST_HP_X: float       = 5.0;
let ST_HP_Y: float       = 17.0;
let ST_HP_W: float       = 64.0;
let ST_HP_H: float       = 64.0;
let ST_MP_X: float       = 6.0;
let ST_MP_Y: float       = 54.0;
let ST_MP_W: float       = 64.0;
let ST_MP_H: float       = 64.0;

pub struct[openpal3.IPal3StatusRenderer] Pal3StatusRendererImpl(
    pub sprites: &scripting_services.ISpriteService,
    // In-game menu (state) atlas: resolves `ui/gamemainui/*` sprites.
    pub atlas: &openpal3.IPal3UiAtlas,
    pub bk: ?&scripting_services.ISprite,
    pub hp: ?&scripting_services.ISprite,
    pub mp: ?&scripting_services.ISprite,
    pub note: array<?&scripting_services.ISprite>,
    // Three avatar variants per role: normal, hover, pressed.
    pub faces: array<?&scripting_services.ISprite>,
    pub menu: &state_menu.MenuState,
    pub loading_screen: &loading.LoadingScreen,
    pub hud_pressed: bool = false,
    // Whether the full-screen character-status menu is open.
    pub menu_open: bool = false,
    // Previous-frame left-button state for press/release detection.
    pub prev_down: bool = false,
    pub menu_needs_refresh: bool = false,
) {
    pub fn render_loading(self: &Self, ui: &radiance.IUiHost, progress: float, dt: float) -> bool {
        return self.loading_screen.paint(ui, progress, dt);
    }

    pub fn render_status(self: &Self, ui: &radiance.IUiHost, dt: float, gameplay: &openpal3.IPal3MenuState) -> int {
        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }
        if !self.menu_open { self.menu.on_close(gameplay); }

        let panel = lh * ST_PANEL_HEIGHT_FACTOR;
        let s = panel / ST_BK_SIZE;
        // Hang bk's transparent right pad off-screen so the dial is flush
        // right; cancel its top pad and leave a small native top gap.
        let x1 = lw + ST_BK_RIGHT_PAD * s;
        let x0 = x1 - panel;
        let y0 = (ST_TOP_GAP_PX - ST_BK_TOP_PAD) * s;
        let y1 = y0 + panel;

        // Each element is laid out in native px relative to bk's top-left
        // corner (x0, y0), then scaled by `s`.
        let ax0 = x0 + ST_AVATAR_X * s;
        let ay0 = y0 + ST_AVATAR_Y * s;
        let ax1 = ax0 + ST_AVATAR_W * s;
        let ay1 = ay0 + ST_AVATAR_H * s;
        let hx0 = x0 + ST_HP_X * s;
        let hy0 = y0 + ST_HP_Y * s;
        let hx1 = hx0 + ST_HP_W * s;
        let hy1 = hy0 + ST_HP_H * s;
        let mx0 = x0 + ST_MP_X * s;
        let my0 = y0 + ST_MP_Y * s;
        let mx1 = mx0 + ST_MP_W * s;
        let my1 = my0 + ST_MP_H * s;

        let pmx = ui.mouse_pos_x();
        let pmy = ui.mouse_pos_y();
        let down = ui.mouse_down(0);
        // Rising edge: pressed this frame but not last.
        let press = down && !self.prev_down;
        let release = !down && self.prev_down;
        let over = pmx >= ax0 && pmx <= ax1 && pmy >= ay0 && pmy <= ay1;
        let was_open = self.menu_open;
        // Agent opens can arrive after pre-update. Leave one HUD frame for
        // the next pre-update to capture, before painting any menu chrome.
        let paint_menu = was_open && !self.menu_needs_refresh;
        if press { self.hud_pressed = over && !was_open; }

        // Decorative variant: click (mouse down over panel) > hover > normal.
        let mut role = 0;
        let mut hp_fraction = 1.0;
        let mut mp_fraction = 1.0;
        if gameplay.available() {
            let game = gameplay;
            role = game.controlled_role();
            if role < 0 || role >= 5 { role = 0; }
            hp_fraction = state_menu.resource_fraction(game.role_value(role, 3), game.role_value(role, 6));
            mp_fraction = state_menu.resource_fraction(game.role_value(role, 5), game.role_value(role, 8));
        }
        let mut variant = 0;
        if over {
            variant = if down { 2 } else { 1 };
        }
        let face = self.faces[role * 3 + variant];

        // Draw the HUD dial first so the full-screen menu (drawn below)
        // composites OVER it — the menu owns the screen while open.
        if !paint_menu {
            let items: array<box<gui.Element>> = [
                sprite_rect(self.bk, x0, y0, x1, y1),
                sprite_rect(face, ax0, ay0, ax1, ay1),
            ];
            let root = gui.Stack(items);
            gui.paint_root(root, ui, gui.make_ctx());
            paint_gauge(ui, self.hp, hx0, hy0, hx1, hy1, hp_fraction, 37.0 / 64.0);
            paint_gauge(ui, self.mp, mx0, my0, mx1, my1, mp_fraction, 29.0 / 64.0);
        }

        // The full-screen character-status menu, painted on top of the HUD.
        if was_open {
            if self.menu_needs_refresh {
                self.menu.on_open(gameplay);
                self.menu_needs_refresh = false;
            } else {
                self.menu.tick(ui.time_milliseconds(), down);
                let stay = self.menu.paint(ui, self.atlas, gameplay, pmx, pmy, press, release, down);
                self.menu_open = stay;
            }
        }

        // A release only opens the menu after a press inside the avatar.
        if !was_open && over && release && self.hud_pressed {
            self.menu_open = true;
            self.menu_needs_refresh = true;
        }
        if release { self.hud_pressed = false; }
        self.prev_down = down;
        0
    }

    pub fn render_reward_notice(self: &Self, ui: &radiance.IUiHost,
        text: string, elapsed: float, row: int) -> int {
        let fade_time = if elapsed > 1.5 { elapsed - 1.5 } else { 0.0 };
        let alpha = if fade_time < 2.5 { 1.0 - fade_time * 0.4 } else { 0.0 };
        let mut units = 0;
        for i in Range(0, text.len_chars()) {
            units = units + if text.char_at(i)!.len_bytes() == 1 { 1 } else { 2 };
        }
        ui.text_at_size(
            (ui.display_size_x() as float - (units as float) * 10.0) * 0.5,
            40.0 + (row as float) * 24.0,
            20.0, 1.0, 1.0, 1.0, alpha, text,
        );
        0
    }

    pub fn render_notice(self: &Self, ui: &radiance.IUiHost, text: string) -> int {
        let lines = state_menu.description_lines(text);
        let font_size = if lines.len() == 1 && text.len_chars() <= 10 { 20.0 } else { 16.0 };
        let width = 274.0;
        let content_height = (lines.len() as float) * (font_size + 4.0) - 4.0;
        let height = if content_height + 40.0 > 77.0 { content_height + 40.0 } else { 77.0 };
        let x0 = (ui.display_size_x() as float - width) * 0.5;
        let y0 = 10.0;
        let x1 = x0 + width;
        let y1 = y0 + height;
        let edge = 32.0;

        paint_note_tile(ui, self.note[0], x0, y0, x0 + edge, y0 + edge);
        paint_note_tile(ui, self.note[1], x0, y1 - edge, x0 + edge, y1);
        paint_note_tile(ui, self.note[2], x1 - edge, y1 - edge, x1, y1);
        paint_note_tile(ui, self.note[3], x1 - edge, y0, x1, y0 + edge);
        paint_note_tile(ui, self.note[4], x0, y0 + edge, x0 + edge, y1 - edge);
        paint_note_tile(ui, self.note[5], x0 + edge, y1 - edge, x1 - edge, y1);
        paint_note_tile(ui, self.note[6], x1 - edge, y0 + edge, x1, y1 - edge);
        paint_note_tile(ui, self.note[7], x0 + edge, y0, x1 - edge, y0 + edge);
        paint_note_tile(ui, self.note[8], x0 + edge, y0 + edge, x1 - edge, y1 - edge);

        for i in Range(0, lines.len()) {
            let line = lines[i];
            let mut units = 0;
            for j in Range(0, line.len_chars()) {
                units = units + if line.char_at(j)!.len_bytes() == 1 { 1 } else { 2 };
            }
            let text_width = (units as float) * font_size * 0.5;
            ui.text_at_size(
                x0 + (width - text_width) * 0.5,
                y0 + (height - content_height) * 0.5 + (i as float) * (font_size + 4.0),
                font_size,
                250.0 / 255.0, 1.0, 1.0, 1.0,
                line,
            );
        }
        0
    }

    // Agent-server hook: open/close the character-status menu without a
    // synthetic avatar click. Takes effect on the next idle frame.
    pub fn set_menu_open(self: &Self, open: bool) -> int {
        self.menu_open = open;
        self.menu_needs_refresh = open;
        self.hud_pressed = false;
        0
    }

    // Whether the character-status menu is open. The adventure director
    // polls this each frame to freeze the game world while it's up.
    pub fn is_menu_open(self: &Self) -> bool {
        return self.menu_open;
    }
}

// Place a sprite in the rect `(x0, y0)-(x1, y1)`. The screen-local
// `SpriteRect` element this used to wrap is gone — `gui.Sprite` is the shared
// widget for "blit an `ISprite` into the rect the parent assigns", and it is
// null-safe, so the caller no longer needs its own guard.
fn sprite_rect(
    s: ?&scripting_services.ISprite,
    x0: float, y0: float, x1: float, y1: float,
) -> box<gui.Element> {
    return gui.Positioned(x0, y0, x1 - x0, y1 - y0, gui.Sprite(s));
}

fn paint_note_tile(
    ui: &radiance.IUiHost,
    sprite: ?&scripting_services.ISprite,
    x0: float, y0: float, x1: float, y1: float,
) {
    if sprite == null { return; }
    let s = sprite!;
    ui.image_rect(s.com_id(), x0, y0, x1, y1, s.u0(), s.v0(), s.u1(), s.v1());
}

fn paint_gauge(ui: &radiance.IUiHost, sprite: ?&scripting_services.ISprite,
    x0: float, y0: float, x1: float, y1: float, fraction: float, visible_height: float) {
    if sprite == null || fraction <= 0.0 { return; }
    let sp = sprite!;
    // Both shipped arc textures have transparent padding above the gauge.
    let top = y1 - (y1 - y0) * visible_height * fraction;
    let v0 = sp.v1() - (sp.v1() - sp.v0()) * visible_height * fraction;
    ui.image_rect(sp.com_id(), x0, top, x1, y1, sp.u0(), v0, sp.u1(), sp.v1());
}

pub fn make_pal3_status_renderer(
    sprites: &scripting_services.ISpriteService,
    atlas: &openpal3.IPal3UiAtlas,
) -> &openpal3.IPal3StatusRenderer {
    let face = "/basedata/basedata/ui/scene/face/";
    let bk = sprites.load_sprite(face + "bk.tga");
    let hp = sprites.load_sprite(face + "mp.tga");
    let mp = sprites.load_sprite(face + "hp.tga");
    let mut note: array<?&scripting_services.ISprite> = [];
    let note_base = "/basedata/basedata/ui/flex/Note";
    let digits: array<string> = ["0", "1", "2", "3", "4", "5", "6", "7", "8"];
    for index in Range(0, 9) {
        note.push(sprites.load_sprite(note_base + digits[index] + ".tga"));
    }
    let mut faces: array<?&scripting_services.ISprite> = [];
    for role in Range(0, 5) {
        for variant in Range(0, 3) {
            faces.push(sprites.load_sprite(face + "face" + digits[role] + "/face" + digits[role] + digits[variant] + ".tga"));
        }
    }
    return &Pal3StatusRendererImpl(sprites, atlas, bk, hp, mp, note, faces, state_menu.make_menu(),
        loading.make_loading(sprites), false, false, false);
}
