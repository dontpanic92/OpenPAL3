module(rust) yaobow_editor::comdef::editor_services;
module(protosept) yaobow_editor.yaobow_editor_services;

import crosscom.idl;
import radiance.idl;
import scripting_services.idl;

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c01)]
interface IImageHandle: IUnknown {
    int width();
    int height();

    int texture_com_id();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c02)]
class ImageHandle: IImageHandle {}

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c03)]
interface IAudioHandle: IUnknown {
    void toggle();

    int state();
    void update();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c04)]
class AudioHandle: IAudioHandle {}

// `class VideoHandle` declaration moved to `shared_services.idl` so
// `ComObject_VideoHandle!` generates in `shared` (its Rust impl lives
// in `shared::loaders::video_handle`). Editor consumes both the
// interface and the concrete class through the shared crates.

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c07)]
interface IPreviewSession: IUnknown {
    void close();

    // Offscreen target the editor's content tab samples via
    // `ui.image(target.texture_id(), w, h)`. Stays valid for the
    // session's lifetime; `target.resize(w, h)` reuses the same com_id.
    IRenderTarget target();

    // Per-frame camera controller for orbit/pan/zoom previews.
    //   dx, dy: pointer-pixel deltas (positive right / down).
    //   wheel: scroll delta (positive zooms in).
    //   buttons: bitmask of held buttons —
    //            bit 0 = left  -> orbit (yaw/pitch around focus)
    //            bit 1 = right -> pan   (translate focus in camera plane)
    //            bit 2 = middle (reserved)
    void tick_camera(float dx, float dy, float wheel, int buttons);
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c08)]
class PreviewSession: IPreviewSession {}

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c09)]
interface IModelHandle: IUnknown {
    &str text_dump();

    IPreviewSession open_preview();

    // Export the model as a single-file glTF binary (`.glb`) at
    // `output_path`. Returns true on success. Implementations may
    // return false if the underlying format has no glTF exporter yet
    // (e.g. dff/anm/bsp).
    bool export_glb(&str output_path);
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c0a)]
class ModelHandle: IModelHandle {}

// Read-only handle to a parsed CEGUI-style UI layout: see
// `IUiLayoutHandle` in `scripting_services.idl`. The editor consumes
// the same interface (via `IPreviewerHub.open_ui_layout`) that PAL4
// uses at runtime (via `IPal4Service.open_layout`); the interface was
// promoted to `scripting_services.idl` so the Rust implementation can
// live in `radiance_scripting::services::ui_layout` and be reused by
// both call sites.

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c0b)]
interface IPreviewerHub: IUnknown {
    int classify(&str vfs_path);
    &str open_text(&str vfs_path);
    &str dump_structured(&str vfs_path);
    IImageHandle? open_image(&str vfs_path);
    IAudioHandle? open_audio(&str vfs_path);
    IVideoHandle? open_video(&str vfs_path);
    IModelHandle? open_model(&str vfs_path);

    // Try to interpret `vfs_path` as a scene the editor can open as a
    // multi-entity preview (e.g. PAL4 `.bsp` / `.gob` blocks). Returns
    // null for any path the hub cannot classify as a scene; the caller
    // should fall back to `open_model` / other previewers.
    ISceneHandle? open_scene(&str vfs_path);

    // Parse a `<GUILayout>` XML file and return a draw-list handle.
    // Returns null for any path the hub cannot classify as a layout
    // (`classify` returns KIND_UI_LAYOUT). The handle owns its
    // uploaded imageset textures for its lifetime; dropping it
    // releases them via the same pending-forget queue
    // `ImageHandle`/`VideoHandle` use.
    IUiLayoutHandle? open_ui_layout(&str vfs_path);

    // Lazy category index over the VFS. Built on first call and
    // cached for the hub's lifetime.
    IResourceManager resources();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c0c)]
class PreviewerHub: IPreviewerHub {}

// Read-only category-based browser over the editor's MiniFs. Categories
// are buckets keyed by extension (scenes, models, textures, audio,
// video, scripts, data, other). Built lazily on first method call.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c10)]
interface IResourceManager: IUnknown {
    int category_count();
    &str category_name(int idx);
    int category_entry_count(int idx, &str filter);
    &str category_entry_path(int idx, &str filter, int row);

    // Drops the cached category index so the next `category_*` call
    // rescans the VFS. Called by `IProjectService` whenever an active
    // project's tracked changes are staged/removed/reverted, since
    // those mutate the project overlay mounted into the VFS (new
    // `Add` paths in particular would otherwise never appear).
    void invalidate();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c11)]
class ResourceManager: IResourceManager {}

// Read-only multi-entity scene preview. The handle exposes a flat
// node tree (parent-pointer encoding) the outline panel walks, and
// builds an `IScenePreviewSession` whose offscreen target the
// viewport samples like the existing `IPreviewSession`.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c12)]
interface ISceneHandle: IUnknown {
    IScenePreviewSession open_preview();

    int node_count();
    int node_parent(int id);
    &str node_name(int id);
    int node_kind(int id);
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c13)]
class SceneHandle: ISceneHandle {}

// Extends `IPreviewSession` semantics with selection + gizmo + an
// on-demand inspector view of the selected node. Read-only — no
// mutation paths are exposed.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c14)]
interface IScenePreviewSession: IUnknown {
    void close();
    IRenderTarget target();
    void tick_camera(float dx, float dy, float wheel, int buttons);

    void set_selection(int node_id);
    int selection();
    void set_gizmo_visible(int axes, int aabb, int pivot);

    IInspectorView inspector_for(int node_id);
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c15)]
class ScenePreviewSession: IScenePreviewSession {}

// Read-only key/value snapshot of a scene node. Inspector script
// queries it once per frame from the current selection and renders
// rows via `IUiHost.table`.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c16)]
interface IInspectorView: IUnknown {
    int field_count();
    &str field_key(int i);
    &str field_value(int i);
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c17)]
class InspectorView: IInspectorView {}

// Authoring-side asset project lifecycle: create/open/save/close a
// project layered on top of the currently opened game's base asset
// tree, enumerate/stage/remove tracked changes, and publish a
// `.yapatch`. Backed by `asset_project::{ProjectManifest, PayloadStore,
// patch}`. All methods that mutate project state also refresh the
// project overlay mounted into the editor's VFS (see
// `services::project_overlay`) and invalidate `IResourceManager`'s
// cached category index, so previews/browsing reflect the change
// immediately.
//
// The p7-facing surface below intentionally sticks to `&str`/`int`/
// `bool` parameters (no byte buffers cross the IDL boundary — `p7` has
// no byte-array type). `stage_payload_file` reads the source bytes
// from disk on the Rust side; a future glTF conversion wizard that
// already holds converted bytes in memory should call the richer
// `Rust`-only API on `services::project_service::ProjectService`
// directly (see doc comments there) rather than round-tripping
// through a temp file.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c19)]
interface IProjectService: IUnknown {
    // Creates a brand-new project rooted at `project_dir` (created if
    // missing) targeting the currently opened game and its currently
    // configured base asset path, then makes it the active project.
    // The project name is derived from `project_dir`'s last path
    // component. Fails (returns false, see `last_error`) if
    // `project_dir` is empty or a project already exists there.
    bool create_project(&str project_dir);

    // Opens a previously created project from either its directory or
    // its `project.json` manifest file directly, and makes it the
    // active project. Validates that the manifest's `target_game`
    // matches the currently opened game and that its
    // `base_asset_root` matches the currently configured asset path
    // before activating — on mismatch this fails (returns false) and
    // leaves any previously active project untouched.
    bool open_project(&str project_path);

    // Persists the active project's manifest to disk. False (see
    // `last_error`) if there is no active project or the write fails.
    bool save_project();

    // Deactivates the current project (clearing the preview overlay)
    // without deleting anything on disk. Refuses to discard unsaved
    // changes; call save_project or discard_and_close_project first.
    bool close_project();
    bool discard_and_close_project();

    bool has_active_project();
    bool is_dirty();
    &str active_project_name();
    &str active_project_dir();
    &str active_project_target_game();
    &str active_project_base_asset_root();

    // Number of tracked `Add`/`Replace` changes in the active project
    // (0 if no project is active).
    int change_count();

    // Per-change accessors, indexed `[0, change_count())` in stable
    // (target_package, package_internal_path) order. Out-of-range
    // indices return an empty/zero value.
    int change_kind(int index); // 0 = Add, 1 = Replace
    // Project change kind for an absolute VFS file path:
    // -1 = unchanged/unresolvable, 0 = Add, 1 = Replace.
    int asset_change_kind(&str vfs_path);
    // Aggregate kind for changed descendants of an absolute VFS directory.
    // Replace wins over Add for mixed subtrees.
    int descendant_change_kind(&str vfs_directory);
    &str change_target_package(int index);
    &str change_internal_path(int index);
    // Hex `ContentHash` of the payload bytes for this change.
    &str change_content_hash(int index);
    int change_payload_size(int index);
    // Hex `ContentHash` of the base package entry this change
    // replaces, captured the first time the change was staged. Empty
    // for `Add` changes or when unavailable.
    &str change_base_hash(int index);
    // "" if the change carries no recorded source path.
    &str change_source_path(int index);
    // "" if the change carries no recorded conversion tool metadata.
    &str change_conversion_tool(int index);
    &str change_conversion_tool_version(int index);

    // Removes the tracked change at `index` from the project manifest
    // (the underlying base package is untouched either way — this
    // only forgets the authored replacement/addition).
    bool remove_change(int index);

    // Reverts the tracked change at `index`: identical effect to
    // `remove_change`, named separately so the "Project Changes" panel
    // can offer a "revert to base" action distinct from "remove from
    // list" even though today both discard the same manifest entry.
    bool revert_change(int index);

    // Reads `source_file_path` from disk and stages it as the payload
    // for `(target_package, internal_path)`, tagged with
    // `tool`/`tool_version` conversion metadata. Automatically
    // classifies the change as `Add` or `Replace` (based on whether
    // the path already exists in the base asset tree) and — for a
    // *new* tracked entry only — captures `base_entry_hash` from the
    // current base content for optimistic-concurrency checks at
    // publish/install time. Re-staging an already-tracked change
    // preserves its originally captured `base_entry_hash`.
    bool stage_payload_file(
        &str target_package,
        &str internal_path,
        &str source_file_path,
        &str tool,
        &str tool_version
    );

    // Rebuilds the project overlay's vfs-path index and invalidates
    // `IResourceManager`'s cached category index. Called automatically
    // by every mutating method above; exposed so script UI can force a
    // rebuild (e.g. after an external, non-`IProjectService` change to
    // the base asset tree).
    void rebuild_overlay_index();

    // Packs every tracked change into a `.yapatch` at `output_path`.
    // False (see `last_error`) if there is no active project, it has
    // no changes, or publishing fails.
    bool publish_patch(&str output_path);

    // Human-readable detail for the most recent failed call on this
    // interface. Empty string if the most recent call succeeded.
    &str last_error();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c1a)]
class ProjectService: IProjectService {}

// Unified glTF (`.glb`/`.gltf`) import wizard: converts an authored
// scene into an existing PAL3 target format (`.mv3`/`.pol`/`.cvd`) plus
// referenced TGA textures via `shared::importers::convert_gltf_to_bundle`,
// and can route the resulting artifact bundle to a "save converted files to
// disk" output, an "add to the
// active `IProjectService` project" output (as a tracked `Add`/
// `Replace` change), or both. See
// `services::import_service::ImportService`'s module docs for the
// full step-by-step contract (this IDL surface sticks to
// `&str`/`int`/`bool`/`float`, matching `IProjectService`'s p7-facing
// convention — no byte buffers cross the IDL boundary).
//
// The editor UI always stages into the active project and selects mode/location
// from its entry point; the local-disk output remains available to tests/tools.
// Typical script-side flow:
//   1. `reset()` (wizard opened), then either
//      `set_replace_target(ctx_vfs_path)` or
//      `set_add_target_directory_from_sibling(ctx_vfs_path)`.
//   2. `set_source_path(...)` (from `IConfigService.pick_open_file`),
//      `set_target_format(...)`, `set_mode(...)`, plus either
//      `set_replace_target(...)` or
//      `set_add_target_package(...)`/`set_add_target_directory(...)`.
//   3. Optionally tweak the per-format option setters.
//   4. `convert()` to preview `diagnostic_count()`/`diagnostic(i)`.
//   5. Configure `set_save_to_file(...)` /`set_add_to_project(...)`
//      (at least one required) and call `run()`; inspect `status()`/
//      `last_error()`/`staged_preview_vfs_path()` afterwards.
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c1b)]
interface IImportService: IUnknown {
    // Clears every field below back to its default/unselected state.
    // Call when the wizard is opened or cancelled.
    void reset();

    // Absolute path to the source `.glb`/`.gltf` file, chosen via
    // `IConfigService.pick_open_file`.
    void set_source_path(&str path);
    &str source_path();

    // Target format: 0 = Mv3, 1 = Pol, 2 = Cvd. Invalid values are
    // ignored (the previous value is kept).
    void set_target_format(int format);
    int target_format();

    // Wizard mode: 0 = Replace an existing asset, 1 = Add a new one.
    // Invalid values are ignored.
    void set_mode(int mode);
    int mode();

    // Replace mode: resolves `vfs_path` through the packfs catalog to
    // its owning package + internal path, and reads its current bytes
    // (the live VFS content — base package, or an already-staged
    // replacement — see `IProjectService`'s overlay docs) as the
    // conversion template. The target format is derived from the
    // `.mv3`/`.pol`/`.cvd` extension. Returns true if `vfs_path`
    // resolved to a supported asset in a mounted package (false, see
    // `last_error`, otherwise).
    bool set_replace_target(&str vfs_path);
    &str replace_target_package();
    &str replace_target_internal_path();

    // Add mode: candidate target packages, restricted to mounted
    // `.cpk` packages (every PAL3/3A/4/5 model/scene package uses
    // this format). `idx` is `[0, add_target_candidate_count())`.
    int add_target_candidate_count();
    &str add_target_candidate_name(int idx);
    void set_add_target_package(&str target_package);
    &str add_target_package();
    // Directory (internal-path prefix; "" = package root) the new
    // file is placed under; combined with the source file's basename
    // (re-extensioned to the target format) to form the final
    // internal path.
    void set_add_target_directory(&str directory);
    &str add_target_directory();
    // Convenience for the "model/resource context" entry point: sets
    // both the target package and directory from an existing vfs
    // path's catalog resolution (its package, and its internal path
    // minus the file name). Returns true if `vfs_path` resolved.
    bool set_add_target_directory_from_sibling(&str vfs_path);
    // Final computed internal path (directory + source basename +
    // target extension), or "" if the source path/target package
    // aren't set yet.
    &str add_target_internal_path();
    // True if `add_target_package()`/`add_target_internal_path()` are
    // both non-empty and the internal path does not already exist in
    // the base asset tree (an existing path should use Replace
    // instead — `convert`/`run` fail with an explanatory
    // `last_error` otherwise).
    bool add_target_valid();

    // --- per-format conversion options, see `shared::importers::target` ---
    void set_mv3_vertex_scale(float scale);
    void set_mv3_ticks_per_second(float ticks);
    // -1 = unset (let the source glTF material decide), 0 = force
    // off, 1 = force on.
    void set_pol_force_use_alpha(int mode);
    void set_cvd_legacy_magic(bool legacy);

    // --- outputs: independent checkboxes, at least one required ---
    void set_save_to_file(bool enabled);
    bool save_to_file_enabled();
    // Destination for the "save converted file" output, chosen via
    // `IConfigService.pick_save_file`.
    void set_save_output_path(&str path);
    &str save_output_path();
    void set_add_to_project(bool enabled);
    bool add_to_project_enabled();

    // Runs the glTF -> target-format conversion exactly once and
    // caches the result (bytes + diagnostics); repeated calls with
    // unchanged inputs are cheap no-ops, while changing any setter
    // above invalidates the cache so the next `convert()`/`run()`
    // reconverts. Returns true if conversion succeeded. Use this to
    // show a diagnostics/summary preview before committing to an
    // output.
    bool convert();
    bool has_converted();
    int diagnostic_count();
    &str diagnostic(int index);
    int converted_size();

    // Converted artifact bundle, indexed `[0, planned_file_count())`.
    // Kind: 0 = target model, 1 = generated TGA texture.
    // `planned_file_path` is the package-internal path derived from the
    // current Replace/Add target. Project action: 0 = Add, 1 = Replace,
    // -1 when the target is incomplete/invalid.
    int planned_file_count();
    int planned_file_kind(int index);
    &str planned_file_path(int index);
    int planned_file_size(int index);
    int planned_file_project_action(int index);

    // Executes every enabled output (converting first if not already
    // converted), routing the SAME artifact bundle to both when both are
    // enabled. Fails outright (returns false, see `last_error`)
    // if neither output is enabled, or conversion itself fails.
    // Returns true only when every enabled output fully succeeds;
    // see `status()` for the partial-success case.
    bool run();

    // 0 = not run yet, 1 = success (every enabled output succeeded),
    // 2 = partial (conversion succeeded and at least one enabled
    // output succeeded, but at least one other enabled output
    // failed), 3 = failed (conversion failed, or every enabled
    // output failed).
    int status();

    // vfs path of the change staged into the active project by the
    // most recent successful `run()`, if it resolves through the
    // catalog to a live-previewable location (see `IProjectService`'s
    // overlay docs — e.g. `IPreviewerHub.open_model(...)` /
    // `open_preview()`). "" otherwise.
    &str staged_preview_vfs_path();

    // Human-readable detail for the most recent failed call on this
    // interface. Empty string if the most recent call succeeded.
    &str last_error();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c1c)]
class ImportService: IImportService {}

[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c0d)]
interface IEditorHostContext: IHostContext {
    IPreviewerHub previewers();

    // Allocate a fresh offscreen render target. Used by `PreviewSession`
    // to render a private preview scene into an imgui-sampleable texture.
    IRenderTarget new_render_target(int w, int h);

    // Drive any active preview sessions' offscreen passes BEFORE the
    // current imgui frame is built. Called from the editor director's
    // `update`; idempotent if no sessions are active.
    void render_pending_previews();

    // Authoring-side asset project lifecycle for the currently opened
    // game. See `IProjectService`.
    IProjectService project();

    // Unified glTF import wizard for the currently opened game. See
    // `IImportService`.
    IImportService imports();
}
[uuid(da12dcb1-4f74-4f51-9bff-1d5d3d3e1c0e)]
class EditorHostContext: IEditorHostContext {}

// Test-fixture conforming class so integration tests can mint a
